*Código basico para criar Radio Button*

DATA: V_RESULT TYPE I.

PARAMETERS: P_NUM1 TYPE I,
            P_NUM2 TYPE I.

PARAMETERS: P_MEN RADIOBUTTON GROUP GR1,
            P_MAI RADIOBUTTON GROUP GR1,
            P_VEZ RADIOBUTTON GROUP GR1,
            P_DIV RADIOBUTTON GROUP GR1.

IF P_MEN = 'X'.
  V_RESULT = P_NUM1 - P_NUM2.

ELSEIF P_MAI = 'X'.
  V_RESULT = P_NUM1 + P_NUM2.

ELSEIF P_VEZ = 'X'.
  V_RESULT = P_NUM1 * P_NUM2.

ELSEIF P_DIV = 'X'.
  V_RESULT = P_NUM1 / P_NUM2.

ENDIF.

WRITE: V_RESULT.
